packages:
  kioku-api
  kioku-core
  kioku-cli
  kioku-migrations
  kioku-migrate

with-compiler: ghc-9.12.4

-- keiki-codec-json IS in the build closure: Keiro 0.13 depends on it directly,
-- so this constraint must track the cohort or it becomes a hard solver failure.
-- The PGMQ entries below remain forward-looking pins for optional integrations
-- Kioku does not build, keeping their released cohort explicit so a consumer
-- cannot revive the former Git-pinned PGMQ stack at an older version.
constraints:
  keiki-codec-json ^>=0.9.0.0,
  keiro-pgmq ^>=0.13.0.0,
  pgmq-core ^>=0.5.0.0,
  pgmq-effectful ^>=0.5.0.0,
  pgmq-hasql ^>=0.5.0.0,
  pgmq-migration ^>=0.5.0.0,
  shibuya-pgmq-adapter ^>=0.14.0.0

package blake3
  flags: -avx512 -avx2 -sse41 -sse2
  ghc-options: -optc-DBLAKE3_USE_NEON=0

package postgresql-libpq
  flags: +use-pkg-config
